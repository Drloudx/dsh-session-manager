{
  "compilerOptions": {
    "target": "ES2023",
    "module": "None",
    "moduleResolution": "Node",
    "moduleDetection": "legacy",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "types": [],
    "declaration": true,
    "declarationDir": "lib/types",
    "outDir": "lib",
    "rootDir": "src",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "include": ["src/client.ts"]
}
